# # Local development settings for capstone-teaching-assistant-rz2-be.
# # Copy this file to `.env` from inside this backend folder.

# APP_ENVIRONMENT=development

# # PostgreSQL is provided by docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://capstone:capstone@localhost:5432/capstone

# # RustFS is S3-compatible object storage provided by docker-compose.yml.
# RUSTFS_ENDPOINT_URL=http://localhost:9000
# RUSTFS_ACCESS_KEY=capstone
# RUSTFS_SECRET_KEY=capstone-secret
# RUSTFS_BUCKET_NAME=capstone-files

# # Ollama must be running locally with these models pulled for chat/RAG.
# # Example:
# #   ollama pull qwen3
# #   ollama pull qwen3-vl:2b
# #   ollama pull qwen3-embedding:0.6b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3.5:4b
# OLLAMA_CHAT_TEMPERATURE=0.0
# OLLAMA_VISION_MODEL=qwen3-vl:2b

# # Optional chat generation controls. Leave commented to use Ollama's model and
# # hardware defaults. Lower output/context limits can reduce latency but may
# # truncate answers or useful prompt context.
# # OLLAMA_CHAT_NUM_PREDICT=512
# # OLLAMA_CHAT_NUM_CTX=8192
# # OLLAMA_CHAT_REASONING=false
# # OLLAMA_CHAT_KEEP_ALIVE=10m
# # OLLAMA_CHAT_NUM_THREAD=8
# # OLLAMA_CHAT_NUM_GPU=1

# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIMENSION=1024

# # RAG settings for uploaded documents and images.
# RAG_TOP_K=5
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# MAX_UPLOAD_BYTES=10485760

# # Local JWT settings. Change JWT_SECRET_KEY outside local development.
# JWT_SECRET_KEY=local-dev-change-me-with-at-least-32-bytes
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# # Local-only admin seed values used by `uv run python tools/seed_local_admin.py`.
# LOCAL_ADMIN_USERNAME=admin
# LOCAL_ADMIN_PASSWORD=AdminPassword123!

# # Email delivery for account creation and password resets.
# # EMAIL_BACKEND=console logs emails instead of sending them (local default).
# # EMAIL_BACKEND=smtp sends real mail; for Gmail use an app password (see README).
# EMAIL_BACKEND=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.address@gmail.com
# SMTP_PASSWORD=your16charapppassword
# SMTP_FROM_EMAIL=your.address@gmail.com
# SMTP_FROM_NAME=Capstone Teaching Assistant
# SMTP_TIMEOUT_SECONDS=15
# FRONTEND_LOGIN_URL=http://localhost:3000
# PASSWORD_RESET_COOLDOWN_SECONDS=300
# PASSWORD_RESET_IP_LIMIT=10
# PASSWORD_RESET_IP_WINDOW_SECONDS=600

# Local development settings for capstone-teaching-assistant-rz2-be.
# Copy this file to `.env` from inside this backend folder.

APP_ENVIRONMENT=development

# PostgreSQL is provided by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://capstone:capstone@localhost:5432/capstone

# Temporary local supervisor identity used until real cookie auth is implemented.
DEV_SUPERVISOR_ID=11111111-1111-1111-1111-111111111111

# RustFS is S3-compatible object storage provided by docker-compose.yml.
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=capstone
RUSTFS_SECRET_KEY=capstone-secret
RUSTFS_BUCKET_NAME=capstone-files

# Ollama must be running locally with these models pulled for chat/RAG.
# Example:
#   ollama pull qwen3
#   ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_CHAT_MODEL=qwen3
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_VISION_MODEL=qwen3-vl:2b
#OLLAMA_CHAT_MODEL=qwen3-vl:2b
#OLLAMA_CHAT_MODEL=llava
#OLLAMA_CHAT_TEMPERATURE=0.1
OLLAMA_CHAT_TEMPERATURE=0.0

# Optional chat generation controls. Leave commented to use Ollama's model and
# hardware defaults.
#OLLAMA_CHAT_NUM_PREDICT=512
OLLAMA_CHAT_NUM_PREDICT=4096
OLLAMA_CHAT_NUM_CTX=8192
OLLAMA_CHAT_REASONING=false
OLLAMA_CHAT_KEEP_ALIVE=60m
# OLLAMA_CHAT_NUM_THREAD=8
OLLAMA_CHAT_NUM_GPU=99

OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# MVP RAG settings for uploaded text files.
RAG_TOP_K=5
#RAG_TOP_K=3
#CHUNK_SIZE=1200
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Email delivery for account creation and password resets.
# Set EMAIL_BACKEND=smtp and fill in the Gmail app password to send real mail.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
FRONTEND_LOGIN_URL=http://localhost:3000
