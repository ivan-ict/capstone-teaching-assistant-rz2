# Backend API base URL. Use /api/v1 when Vite proxies to the backend, or the full local backend URL.
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Optional quick-demo credentials. These must be real backend accounts.
VITE_DEMO_ADMIN_USERNAME="admin"
VITE_DEMO_ADMIN_PASSWORD="AdminPassword123!"
VITE_DEMO_SUPERVISOR_USERNAME="supervisor"
VITE_DEMO_SUPERVISOR_PASSWORD="super123"
